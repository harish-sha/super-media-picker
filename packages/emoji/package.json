{
  "name": "@super-media-picker/emoji",
  "version": "0.1.0",
  "description": "Compact emoji data, categories, normalization, and search.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compact": {
      "types": "./dist/compact.d.ts",
      "import": "./dist/compact.js"
    }
  },
  "scripts": {
    "build": "pnpm generate:data && tsup src/index.ts src/compact.ts --format esm --dts --splitting --clean --sourcemap",
    "generate:data": "node scripts/generate-emoji-data.mjs",
    "test": "pnpm generate:data && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm generate:data && tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@super-media-picker/core": "workspace:*"
  },
  "devDependencies": {
    "emojibase": "^17.0.0",
    "emojibase-data": "^16.0.3",
    "tsup": "^8.5.0",
    "vitest": "^3.2.1"
  }
}
