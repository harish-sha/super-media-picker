{
  "name": "super-media-picker",
  "version": "0.1.0-beta.6",
  "description": "Accessible, provider-first media picker for React and standards-based browser applications.",
  "keywords": [
    "emoji-picker",
    "gif-picker",
    "sticker-picker",
    "media-picker",
    "react",
    "typescript",
    "headless",
    "reactions",
    "animated-emoji",
    "web-component",
    "vanilla-js",
    "browser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harish-sha/super-media-picker.git",
    "directory": "packages/super-media-picker"
  },
  "homepage": "https://github.com/harish-sha/super-media-picker#readme",
  "bugs": {
    "url": "https://github.com/harish-sha/super-media-picker/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/browser/styles.css",
    "./dist/browser/super-media-picker.element.js",
    "./dist/browser/super-media-picker.global.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "default": "./dist/providers.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./web": {
      "types": "./dist/browser/super-media-picker.esm.d.ts",
      "import": "./dist/browser/super-media-picker.esm.js",
      "default": "./dist/browser/super-media-picker.esm.js"
    },
    "./element": {
      "types": "./dist/browser/super-media-picker.element.d.ts",
      "import": "./dist/browser/super-media-picker.element.js",
      "default": "./dist/browser/super-media-picker.element.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsup --config tsup.browser.config.ts && tsup --config tsup.global.config.ts && node scripts/copy-styles.mjs",
    "test": "node test/ssr-import.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20.0.0",
    "react-dom": ">=18.3.0 <20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0"
  },
  "unpkg": "./dist/browser/super-media-picker.global.js",
  "jsdelivr": "./dist/browser/super-media-picker.global.js"
}
