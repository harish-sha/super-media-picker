{
  "name": "super-media-picker",
  "version": "0.1.0",
  "private": true,
  "description": "Public consumer entry point for Super Media Picker.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --external react --external react-dom && cp ../react/dist/index.css dist/styles.css && cp ../react/dist/index.css.map dist/index.css.map",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@super-media-picker/gif": "workspace:*",
    "@super-media-picker/react": "workspace:*",
    "@super-media-picker/stickers": "workspace:*",
    "@super-media-picker/themes": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0"
  }
}
