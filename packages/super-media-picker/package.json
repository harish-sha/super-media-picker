{
  "name": "super-media-picker",
  "version": "0.1.0",
  "description": "Accessible, provider-first React picker for emoji, GIFs, stickers, and custom media.",
  "keywords": [
    "emoji-picker",
    "gif-picker",
    "sticker-picker",
    "media-picker",
    "react",
    "typescript"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harish-sha/super-media-picker.git"
  },
  "homepage": "https://github.com/harish-sha/super-media-picker#readme",
  "bugs": {
    "url": "https://github.com/harish-sha/super-media-picker/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/headless.ts src/providers.ts --format esm --dts --splitting --clean --sourcemap --external react --external react-dom && cp ../react/dist/index.css dist/styles.css && cp ../react/dist/index.css.map dist/index.css.map",
    "test": "node test/ssr-import.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@super-media-picker/core": "workspace:*",
    "@super-media-picker/gif": "workspace:*",
    "@super-media-picker/react": "workspace:*",
    "@super-media-picker/stickers": "workspace:*",
    "@super-media-picker/themes": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0"
  }
}
